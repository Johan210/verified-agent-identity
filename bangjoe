name: Verify Human Identity

on:
  workflow_dispatch:
    inputs:1
      agent_name:bangjoe
        description: 'bangjoe'
        required: true
        default: 'bangjoe'
      agent_description:no
        description: 'Agent Description'
        required: true
        default: 'bangjoe'

jobs:
  verify:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repo
        uses: actions/checkout@v3

      - name: Setup Node.js
        uses: actions/setup-node@v3
        with:
          node-version: '20'

      - name: Install dependencies
        run: |
          cd scripts
          npm install

      - name: Step 1 - Create new Ethereum Identity
        run: node scripts/createNewEthereumIdentity.js

      - name: Step 2 - Link Human to Agent
        run: |
          node scripts/manualLinkHumanToAgent.js \
          --challenge "{\"name\": bangjoe\"${{ github.event.inputs.agent_bangjoe }}\", \"description\":bangjoe \"${{ github.event.inputs.agent_description }}\"}"
